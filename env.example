LAYERZERO_ENDPOINT_ARBITRUM_GOERLI=0x6aB5Ae6822647046626e83ee6dB8187151E1d5ab
LAYERZERO_ENDPOINT_OPTIMISM_GOERLI=0xae92d5aD7583AD66E49A0c67BAd18F6ba52dDDc1

# Gas 费用配置 (以 wei 为单位)
GAS_FEE_CREATE_EVENT=200000
GAS_FEE_BUY_TICKET=150000
GAS_FEE_UPDATE_EVENT=100000
GAS_FEE_DELETE_EVENT=50000
GAS_FEE_PAYOUT_EVENT=100000

# 服务费配置 (百分比)
SERVICE_FEE_PERCENTAGE=5

# 跨链测试配置
TEST_SOURCE_CHAIN=goerli
TEST_TARGET_CHAIN=mumbai
TEST_EVENT_CAPACITY=100
TEST_TICKET_COST=0.1
