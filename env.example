# 环境变量配置示例
# 复制此文件为 .env 并填入您的实际值

# Infura API Key (用于访问以太坊网络)
INFURA_API_KEY=your_infura_api_key_here

# 私钥配置 (用于部署和测试)
PRIVATE_KEY_1=your_private_key_1_here
PRIVATE_KEY_2=your_private_key_2_here

# LayerZero 配置
LAYERZERO_ENDPOINT_ETHEREUM=0x66A71Dcef29A0fFBDBE3c6a460a3B5BC225Cd675
LAYERZERO_ENDPOINT_BSC=0x3c2269811836af69497E5F486A85D7316753cf62
LAYERZERO_ENDPOINT_POLYGON=0x3c2269811836af69497E5F486A85D7316753cf62
LAYERZERO_ENDPOINT_AVALANCHE=0x3c2269811836af69497E5F486A85D7316753cf62
LAYERZERO_ENDPOINT_ARBITRUM=0x3c2269811836af69497E5F486A85D7316753cf62
LAYERZERO_ENDPOINT_OPTIMISM=0x3c2269811836af69497E5F486A85D7316753cf62

# 测试网端点
LAYERZERO_ENDPOINT_GOERLI=0xbfD2135BFfbb0B6668E3531c5Ae19138b0dA7361
LAYERZERO_ENDPOINT_BSC_TESTNET=0x6Fcb97553D41516Cb228ac03FdC8B9a0a9df04A1
